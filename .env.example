# ─────────────────────────────────────────────────────────────
# Beauty by Leela — variables de entorno (PLANTILLA, sin valores)
# Copia estos NOMBRES en Vercel → Settings → Environment Variables.
# Los VALORES reales se pegan SOLO en Vercel/Supabase, nunca en el repo ni en el chat.
# ─────────────────────────────────────────────────────────────

# Supabase (públicas — seguras para el navegador)
#   Proyectos nuevos de Supabase muestran "Publishable key" en vez de "anon":
#   Publishable/anon  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRETA — SOLO servidor, jamás con prefijo NEXT_PUBLIC_)
#   "Secret key" (proyectos nuevos) o "service_role" (legacy) -> aquí.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (formulario de contacto — Tanda 10)
RESEND_API_KEY=

# Setmore (deep-link de agendamiento)
#   ⚠️ Subdominio "bylela" (no "byleela") PENDIENTE de confirmar con la clienta.
#   Vive solo aquí como env var — NUNCA hardcodear en componentes.
NEXT_PUBLIC_SETMORE_BASE_URL=https://citasbeautybylela.setmore.com/

# URL pública del sitio — alimenta canónicas, sitemap, Open Graph y Schema.
#   DEUDA (Tanda 12): configurar por entorno.
#     Production -> https://beautybyleela.com
#     Preview    -> URL de preview de Vercel
#   Si queda en *.vercel.app el día del lanzamiento, Google indexa el dominio equivocado.
NEXT_PUBLIC_SITE_URL=
